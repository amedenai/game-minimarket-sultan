<script>
const MISSIONS=[{code:'hack wifi',name:'Hack WiFi Tetangga',xp:100,msg:'Mencoba bobol WiFi...',success:'✅ WiFi berhasil! Password: sultan123'},{code:'sudo access',name:'Akses Root',xp:150,msg:'Mencoba sudo...',success:'✅ Root access granted!'},{code:'buka file',name:'Buka File Rahasia',xp:120,msg:'Membuka secret.txt...',success:'✅ File terbuka! Foto Luna & kucing!'},{code:'trace ip',name:'Lacak IP',xp:200,msg:'Tracing IP...',success:'✅ IP ditemukan di Jakarta!'},{code:'mic on',name:'Nyalakan Mic',xp:80,msg:'Menyalakan mic...',success:'🔴 MIC ON AIR! Halo guys!'},{code:'cat foto',name:'Upload Foto',xp:90,msg:'Upload foto vas bunga...',success:'✅ Foto terupload! 1k likes!'},{code:'nonton tv',name:'Nonton Tutorial di TV',xp:70,msg:'Memutar TV...',success:'📺 Video: Cara jadi hacker cantik!'},{code:'chat wa',name:'Balas WA',xp:60,msg:'Buka HP...',success:'📱 WA dibalas: Oke bos!'}];
let state={money:500000,level:1,xp:0,missionIdx:0,micOn:false,sound:true,audioCtx:null,completed:0};
let term=null;
function initAudio(){if(state.audioCtx)return;state.audioCtx=new(window.AudioContext||window.webkitAudioContext)();}
function playType(){if(!state.sound)return;initAudio();let o=state.audioCtx.createOscillator(),g=state.audioCtx.createGain();o.type='square';o.frequency.value=800+Math.random()*600;g.gain.setValueAtTime(0.15,state.audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(0.001,state.audioCtx.currentTime+0.05);o.connect(g);g.connect(state.audioCtx.destination);o.start();o.stop(state.audioCtx.currentTime+0.06);}
function playMicOn(){if(!state.sound)return;initAudio();[600,900,1200].forEach((f,i)=>{let o=state.audioCtx.createOscillator(),g=state.audioCtx.createGain();o.frequency.value=f;g.gain.setValueAtTime(0.25,state.audioCtx.currentTime+i*0.12);g.gain.exponentialRampToValueAtTime(0.001,state.audioCtx.currentTime+i*0.12+0.25);o.connect(g);g.connect(state.audioCtx.destination);o.start(state.audioCtx.currentTime+i*0.12);o.stop(state.audioCtx.currentTime+i*0.12+0.3);});}
function playSuccess(){if(!state.sound)return;initAudio();[523,659,784,1046].forEach((f,i)=>{let o=state.audioCtx.createOscillator(),g=state.audioCtx.createGain();o.frequency.value=f;g.gain.setValueAtTime(0.25,state.audioCtx.currentTime+i*0.1);g.gain.exponentialRampToValueAtTime(0.001,state.audioCtx.currentTime+i*0.1+0.4);o.connect(g);g.connect(state.audioCtx.destination);o.start(state.audioCtx.currentTime+i*0.1);o.stop(state.audioCtx.currentTime+i*0.1+0.4);});}
function playError(){if(!state.sound)return;initAudio();let o=state.audioCtx.createOscillator(),g=state.audioCtx.createGain();o.frequency.value=200;o.type='sawtooth';g.gain.setValueAtTime(0.3,state.audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(0.001,state.audioCtx.currentTime+0.3);o.connect(g);g.connect(state.audioCtx.destination);o.start();o.stop(state.audioCtx.currentTime+0.3);}
function toggleSound(){state.sound=!state.sound;document.getElementById('soundStat').textContent=state.sound?'🔊':'🔇';if(state.sound)playType();}
function log(msg,cls=''){let div=document.createElement('div');div.className='termLine '+cls;div.textContent='> '+msg;term.appendChild(div);term.scrollTop=term.scrollHeight;}
function clearTerm(){term.innerHTML='';log('Terminal Luna siap...','sys');log('Ketik "help" untuk bantuan','sys');}
function clickEq(type){
let bubble=document.getElementById('bubble');
if(type==='laptop'){bubble.textContent='💻 Laptop spek dewa! RTX 4090! Lagi ngeretas nih!';log('💻 Laptop: CPU 78% • RTX ON','ok');}
if(type==='phone'){bubble.textContent='📱 HP bunyi! WA: "Luna, hack IG mantan dong!" 😂';log('📱 HP: 3 notif WA • Baterai 87%','warn');playType();}
if(type==='mic'){state.micOn=!state.micOn;let mic=document.getElementById('eqMic');if(state.micOn){mic.classList.add('micOn');bubble.textContent='🎙️ MIC ON AIR! 🔴 Halo guys, welcome to hacker stream!';log('🔴 MIC ON AIR - Recording...','ok');playMicOn();}else{mic.classList.remove('micOn');bubble.textContent='🎙️ Mic OFF! Mode silent hacker!';log('⚫ MIC OFF','warn');}}
if(type==='vase'){bubble.textContent='🌸 Vas bunga sakura! Bikin semangat +10 XP!';log('🌸 Vas Bunga: Sakura pink • +10 XP','ok');state.xp+=10;updateXP();playSuccess();}
if(type==='tv'){bubble.textContent='📺 TV jadi monitor kedua! Nampilin log hack & anime!';log('📺 TV: HDMI 2 - 4K - Matrix code','sys');}
if(type==='keyboard'){bubble.textContent='⌨️ Keyboard RGB! Bunyi tik-tik satisfying!';for(let i=0;i<8;i++)setTimeout(playType,i*60);}
if(type==='cam'){bubble.textContent='📹 Webcam Live! 2k viewers!';log('📹 Webcam: ON - 2.1k viewers','warn');}
if(type==='headset'){bubble.textContent='🎧 Headset RGB! Lo-fi beats!';log('🎧 Headset: Razer RGB ON','sys');}
}
function updateXP(){document.getElementById('xp').textContent=state.xp+' XP';document.getElementById('level').textContent='LVL '+Math.floor(state.xp/300+1)+' Hacker';}
function useHint(){if(state.money<25000){log('💸 Uang tidak cukup!','err');return;}state.money-=25000;document.getElementById('money').textContent=state.money.toLocaleString('id-ID');let m=MISSIONS[state.missionIdx];log(`💡 HINT: Ketik "${m.code}"`,'warn');}
function executeCode(){
let input=document.getElementById('codeInput');let code=input.value.toLowerCase().trim();
if(!code){log('Ketik kode dulu!','err');return;}
log(code,'');
if(code==='help'){log('Daftar kode:','sys');MISSIONS.forEach(m=>log(`- ${m.code} : ${m.name}`,'sys'));input.value='';return;}
if(code==='clear'){clearTerm();input.value='';return;}
let mission=MISSIONS[state.missionIdx];
if(code===mission.code){
log(mission.msg,'sys');
setTimeout(()=>{log(mission.success,'ok');state.xp+=mission.xp;state.money+=mission.xp*1000;state.completed++;updateXP();document.getElementById('money').textContent=state.money.toLocaleString('id-ID');document.getElementById('missionProgress').textContent=state.completed+'/5';playSuccess();document.getElementById('bubble').textContent=`🎉 Berhasil! ${mission.success} +${mission.xp} XP!`;state.missionIdx=(state.missionIdx+1)%MISSIONS.length;let next=MISSIONS[state.missionIdx];document.getElementById('missionName').textContent=next.name;if(state.completed>=5){log('🏆 SELAMAT! Hacker Girls Sultan!','ok');}},600);
}else{log('❌ Kode salah! Pakai HINT!','err');playError();}
input.value='';
}
function startGame(){
document.getElementById('menuStart').classList.add('hidden');
term=document.getElementById('terminal');
clearTerm();
let m=MISSIONS[0];
document.getElementById('missionName').textContent=m.name;
let keys=document.getElementById('keys');
'abcdefghijklmnopqrstuvwxyz'.split('').forEach(k=>{let b=document.createElement('button');b.textContent=k;b.onclick=()=>{document.getElementById('codeInput').value+=k;playType();};keys.appendChild(b);});
[' space ',' del '].forEach(k=>{let b=document.createElement('button');b.textContent=k;b.style.gridColumn='span 3';b.style.background='#1e293b';b.onclick=()=>{if(k.includes('space')){document.getElementById('codeInput').value+=' ';}else{document.getElementById('codeInput').value=document.getElementById('codeInput').value.slice(0,-1);}playType();};keys.appendChild(b);});
document.getElementById('codeInput').addEventListener('keydown',(e)=>{if(e.key!=='Enter')setTimeout(playType,10);if(e.key==='Enter')executeCode();});
initAudio();
log('Kamar Luna siap! Klik peralatan!','sys');
}
</script>
