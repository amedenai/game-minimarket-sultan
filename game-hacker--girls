#rightPanel{width:320px;background:rgba(15,23,42,.92);border-left:3px solid #a855f7;display:flex;flex-direction:column;z-index:10}
#panelHeader{padding:10px;background:linear-gradient(90deg,#7c3aed,#a855f7);display:flex;justify-content:space-between;align-items:center}
#terminal{flex:1;background:#020617;border:2px solid #1e293b;border-radius:12px;margin:8px;padding:8px;font-family:'JetBrains Mono',monospace;font-size:11px;color:#22d3ee;overflow-y:auto;line-height:1.4}
