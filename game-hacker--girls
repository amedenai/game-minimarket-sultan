.termLine.warn{color:#facc15}
.termLine.err{color:#ef4444}
.termLine.sys{color:#a855f7}
#typingArea{background:#0f172a;border:2px solid #334155;border-radius:14px;margin:0 8px 8px;padding:8px}
#codeInput{width:100%;background:#020617;border:2px solid #a855f7;border-radius:10px;padding:10px;color:#fff;font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;outline:none;box-shadow:0 0 0 4px rgba(168,85,247,.15) inset}
.keys{display:grid;grid-template-columns:repeat(10,1fr);gap:4px;margin-top:8px}
.keys button{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:#fff;border-radius:8px;padding:8px 2px;font-weight:800;font-size:12px;font-family:'JetBrains Mono'}
#actionRow{display:flex;gap:6px;padding:8px}
.actBtn{flex:1;padding:10px;border-radius:12px;border:none;font-weight:800;font-size:11px;box-shadow:0 4px 0 rgba(0,0,0,.3)}
.primary{background:linear-gradient(90deg,#a855f7,#ec4899);color:#fff}
.secondary{background:#1e293b;color:#fff;border:2px solid #334155}
#menuStart{position:fixed;inset:0;z-index:60;background:radial-gradient(ellipse at center,#1e1b4b,#020617);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;text-align:center;overflow-y:auto}
.bigBtn{width:100%;max-width:360px;padding:14px;border-radius:16px;border:2px solid rgba(255,255,255,.2);font-weight:800;font-size:16px;margin:6px 0;box-shadow:0 6px 0 rgba(0,0,0,.4)}
.pill{background:rgba(168,85,247,.2);border:1px solid rgba(168,85,247,.4);padding:6px 14px;border-radius:20px;font-size:11px;margin:4px}
.missionList{width:100%;max-width:360px;background:rgba(255,255,255,.06);border:2px solid rgba(255,255,255,.1);border-radius:16px;padding:12px;margin:10px 0;text-align:left}
.missionItem{padding:8px;border-radius:10px;background:rgba(255,255,255,.05);margin:6px 0;display:flex;gap:8px;align-items:center;font-size:12px}
.missionItem .chk{width:22px;height:22px;border-radius:50%;border:2px solid #334155;display:flex;align-items:center;justify-content:center}
#toast{position:fixed;left:50%;top:20%;transform:translateX(-50%);background:#0f172a;color:#fff;padding:10px 16px;border-radius:14px;font-weight:700;font-size:12px;z-index:80;border:2px solid #fff;display:none}
#soundBtn{position:absolute;top:8px;right:8px;z-index:25;background:rgba(255,255,255,.9);border:2px solid #fff;border-radius:12px;padding:6px 10px;font-size:11px;font-weight:800}
.hidden{display:none!important}
</style>
