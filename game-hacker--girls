<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Hacker Girls - FIX</title>
<style>
body{margin:0;background:#020617;color:#fff;font-family:sans-serif;display:flex;flex-direction:column;height:100vh}
#top{padding:10px;background:#7c3aed;display:flex;justify-content:space-between}
#room{display:flex;flex:1}
#left{flex:1;background:linear-gradient(#1e1b4b,#020617);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:10px;text-align:center}
#right{width:320px;background:#0f172a;border-left:3px solid #a855f7;display:flex;flex-direction:column}
#term{flex:1;background:#000;color:#0f0;padding:10px;font-family:monospace;font-size:12px;overflow:auto}
input{width:100%;padding:12px;background:#000;border:2px solid #a855f7;color:#fff;border-radius:8px;font-family:monospace}
button{padding:10px;margin:5px;border-radius:8px;border:none;font-weight:800}
#girl{font-size:80px;animation:breathe 2s infinite}
@keyframes breathe{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
.eq{width:60px;height:60px;background:#fff;border-radius:12px;display:inline-flex;flex-direction:column;align-items:center;justify-content:center;margin:4px;cursor:pointer;color:#000;font-weight:800;font-size:10px}
.eq:active{transform:scale(.9)}
</style>
</head>
<body>
<div id="top"><b>👩‍💻 HACKER GIRLS</b><span>💰 Rp 500k | ⭐ 0 XP</span><span id="snd" onclick="sound=!sound;this.textContent=sound?'🔊':'🔇'">🔊</span></div>
<div id="room">
<div id="left">
<div id="girl">👩‍💻</div>
<div style="background:#fff;color:#000;padding:8px 12px;border-radius:12px;font-size:12px;max-width:250px;margin:10px" id="bubble">Hai Tuan! Aku Luna! Klik peralatan di bawah!</div>
<div style="background:#1e293b;padding:10px;border-radius:12px;width:95%;margin-top:10px">
<div style="font-size:11px;color:#a855f7;margin-bottom:6px">💜 PERALATAN KAMAR (KLIK!)</div>
<div class="eq" onclick="klik('laptop')">💻<br>LAPTOP</div>
<div class="eq" onclick="klik('hp')">📱<br>HP</div>
<div class="eq" onclick="klik('mic')">🎙️<br>MIC</div>
<div class="eq" onclick="klik('vas')">🌸<br>VAS BUNGA</div>
<div class="eq" onclick="klik('tv')">📺<br>TV</div>
<div class="eq" onclick="klik('key')">⌨️<br>KEYBOARD</div>
</div>
<div style="margin-top:10px;font-size:10px;color:#64748b">⌨️ Ada suara tik-tik + 🎙️ suara mic ON!</div>
</div>
<div id="right">
<div id="term">> Terminal Luna siap...<br>> Ketik "hack wifi" dan ENTER</div>
<div style="padding:8px"><input id="inp" placeholder="Ketik: hack wifi" onkeydown="if(event.key==='Enter')hack()"><div style="display:flex;margin-top:6px"><button onclick="hint()" style="flex:1;background:#334155;color:#fff">💡 HINT</button><button onclick="hack()" style="flex:2;background:#a855f7;color:#fff">▶️ HACK!</button></div></div>
</div>
</div>
<script>
let sound=true,xp=0,ctx;
function init(){try{ctx=new (window.AudioContext||window.webkitAudioContext)()}catch(e){}}
function beep(f,t){if(!sound||!ctx)return;let o=ctx.createOscillator(),g=ctx.createGain();o.frequency.value=f;g.gain.setValueAtTime(0.2,ctx.currentTime);g.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+t);o.connect(g);g.connect(ctx.destination);o.start();o.stop(ctx.currentTime+t)}
function klik(type){init();beep(800,0.1);let b=document.getElementById('bubble');let trm=document.getElementById('term');
if(type==='laptop'){b.textContent='💻 Laptop RTX 4090! Lagi ngehack!';trm.innerHTML+='<br>> 💻 Laptop: RTX ON • CPU 78%';}
if(type==='hp'){b.textContent='📱 HP: WA "Luna hack IG mantan dong!" 😂';trm.innerHTML+='<br>> 📱 HP: 3 notif WA • 5G';}
if(type==='mic'){beep(600,0.2);setTimeout(()=>beep(900,0.2),100);setTimeout(()=>beep(1200,0.2),200);b.textContent='🎙️ MIC ON AIR 🔴 Halo guys!';trm.innerHTML+='<br>> 🔴 MIC ON AIR - Recording...';}
if(type==='vas'){b.textContent='🌸 Vas bunga sakura +10 XP semangat!';xp+=10;trm.innerHTML+='<br>> 🌸 Vas bunga +10 XP!';beep(523,0.3);setTimeout(()=>beep(659,0.3),100);setTimeout(()=>beep(784,0.3),200);}
if(type==='tv'){b.textContent='📺 TV jadi monitor kedua!';trm.innerHTML+='<br>> 📺 TV: Matrix code playing';}
if(type==='key'){for(let i=0;i<6;i++)setTimeout(()=>beep(800+Math.random()*400,0.06),i*50);b.textContent='⌨️ Keyboard RGB tik-tik-tik!';trm.innerHTML+='<br>> ⌨️ Keyboard: tik-tik-tik!';}
trm.scrollTop=trm.scrollHeight;
}
function hack(){let i=document.getElementById('inp');let v=i.value.toLowerCase().trim();let trm=document.getElementById('term');if(!v)return;trm.innerHTML+='<br>> '+v;if(v.includes('hack wifi')||v.includes('hack')||v.includes('sudo')){trm.innerHTML+='<br>> ✅ HACK BERHASIL! +100 XP!';beep(523,0.3);setTimeout(()=>beep(784,0.3),100);setTimeout(()=>beep(1046,0.4),200);xp+=100;document.getElementById('bubble').textContent='🎉 Berhasil hack! Kamu hebat Tuan!';}else{trm.innerHTML+='<br>> ❌ Salah! Coba ketik "hack wifi"';beep(200,0.3);}i.value='';trm.scrollTop=trm.scrollHeight;}
function hint(){let trm=document.getElementById('term');trm.innerHTML+='<br>> 💡 HINT: Ketik "hack wifi"';}
init();
</script>
</body>
</html>
